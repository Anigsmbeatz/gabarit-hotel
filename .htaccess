# ============================================================================
#  EN-TÊTES DE SÉCURITÉ — hébergement Apache / cPanel
#  (LWS, PlanetHoster, OVH mutualisé, la plupart des hébergeurs locaux)
#  Dépose ce fichier à la racine du site. Sur Netlify ou Cloudflare Pages,
#  il ne sert à rien : utilise le fichier _headers à la place.
#  Vérifie le résultat sur securityheaders.com après la mise en ligne.
# ============================================================================

# --- Rediriger tout le trafic vers HTTPS ------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.openstreetmap.org; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# --- Empêcher l'affichage du contenu des dossiers ---------------------------
Options -Indexes

# --- Bloquer l'accès aux fichiers qui ne regardent pas les visiteurs --------
<FilesMatch "^\.|(\.md|\.json|\.log|\.bak|\.zip)$">
  Require all denied
</FilesMatch>

# --- Compression (le site se charge plus vite) ------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain
</IfModule>

# --- Cache long sur les images --------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
